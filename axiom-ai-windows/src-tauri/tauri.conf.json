{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axiom AI",
  "version": "9.5.0",
  "identifier": "technology.axiomai.desktop",
  "build": {
    "devUrl": "https://axiomai.technology",
    "frontendDist": "https://axiomai.technology"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Axiom AI",
        "url": "https://axiomai.technology",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "decorations": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
